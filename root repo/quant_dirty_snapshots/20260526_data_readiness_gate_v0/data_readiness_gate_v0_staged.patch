+        "def bad():\n"
+        "    return build_market_data_provider()\n",
+        encoding="utf-8",
+    )
+
+    check = gate._check_provider_boundary(tmp_path, [module], mode="strict")
+
+    assert check.status == "FAIL"
+    assert any("import:yfinance" in hit for hit in check.metrics["forbidden_hits"])
