+def _load_rule100_softmax_v1_history(path: Path | None = None) -> pd.DataFrame:
+    """Load the additive v1 sizing history artifact for lifecycle audit display."""
+
+    history_path = path or RULE100_SOFTMAX_V1_HISTORY_PATH
