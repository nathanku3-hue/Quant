+        if permno is None:
+            continue
+        try:
+            w = float(weight)
+        except (TypeError, ValueError):
+            continue
+        if np.isfinite(w) and w > 0:
+            weights[permno] = weights.get(permno, 0.0) + w
+
+    series = pd.Series(weights, dtype="float64")
+    total = float(series.sum()) if not series.empty else 0.0
+    if total > 1.0:
+        series = series / total
+    return series
