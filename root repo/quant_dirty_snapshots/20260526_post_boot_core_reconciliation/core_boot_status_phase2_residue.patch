diff --git a/core/boot_status.py b/core/boot_status.py
index 6e8833a..25c0681 100644
--- a/core/boot_status.py
+++ b/core/boot_status.py
@@ -381,6 +381,50 @@ def deferred_check(check_id: str, label: str, summary: str, *, destination: str
     )
 
 
+def readiness_check_from_data_readiness(status: Mapping[str, Any]) -> ReadinessCheck:
+    raw_status = str(status.get("overall_status", "FAIL")).strip().upper()
+    if raw_status == "PASS":
+        check_status = "pass"
+        severity = "ready"
+        summary = "Data readiness gate passed for boot preflight."
+    elif raw_status in {"WARN", "DEFER", "DEFERRED"}:
+        check_status = "warn" if raw_status == "WARN" else "deferred"
+        severity = "degraded"
+        summary = "Data readiness gate is degraded or uncertified for boot preflight."
+    else:
+        check_status = "fail"
+        severity = "blocked"
+        summary = "Data readiness gate failed for boot preflight."
+
+    details: dict[str, Any] = {
+        "overall_status": raw_status,
+        "planning_status": status.get("planning_status"),
+        "strict_status": status.get("strict_status"),
+        "mode": status.get("mode"),
+        "route_id": status.get("route_id"),
+        "route_readiness": status.get("route_readiness"),
+    }
+    summary_payload = status.get("summary")
+    if isinstance(summary_payload, Mapping):
+        details["summary"] = dict(summary_payload)
+        blockers = summary_payload.get("blockers")
+        warnings = summary_payload.get("warnings")
+        if raw_status == "FAIL" and blockers:
+            summary = f"Data readiness gate failed: {len(blockers)} blocker(s)."
+        elif raw_status == "WARN" and warnings:
+            summary = f"Data readiness gate warned: {len(warnings)} warning(s)."
+
+    return ReadinessCheck(
+        id="data_readiness_gate",
+        label="Data readiness gate",
+        status=check_status,
+        severity=severity,
+        summary=summary,
+        destination="Boot Status",
+        details=details,
+    )
+
+
 def status_json_text(status: BootStatus | Mapping[str, Any]) -> str:
     parsed = status if isinstance(status, BootStatus) else BootStatus.from_json_dict(status)
     return parsed.to_json_text()
