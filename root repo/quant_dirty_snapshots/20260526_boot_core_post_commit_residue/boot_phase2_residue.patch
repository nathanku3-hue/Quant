+def test_default_load_prefers_runtime_over_legacy(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    canonical = make_boot_status(
+        source="canonical",
+        flags=BootContextFlags(safe_boot=True),
+        checks=(_ready_check(),),
+        generated_at="2026-05-26T00:00:00Z",
+    )
+    legacy = make_boot_status(
+        source="legacy",
+        flags=BootContextFlags(safe_boot=True),
+        checks=(_ready_check(),),
+        generated_at="2026-05-26T00:00:00Z",
+    )
+    (tmp_path / DEFAULT_BOOT_STATUS_PATH).parent.mkdir(parents=True)
+    (tmp_path / LEGACY_BOOT_STATUS_PATH).parent.mkdir(parents=True)
+    (tmp_path / DEFAULT_BOOT_STATUS_PATH).write_text(canonical.to_json_text(), encoding="utf-8")
+    (tmp_path / LEGACY_BOOT_STATUS_PATH).write_text(legacy.to_json_text(), encoding="utf-8")
+    monkeypatch.chdir(tmp_path)
+
+    loaded = load_boot_status_fail_closed()
+
+    assert loaded.source == "canonical"
+    assert loaded.metadata["loaded_from"] == DEFAULT_BOOT_STATUS_PATH.as_posix()
+    assert loaded.metadata["source_role"] == "canonical"
+
